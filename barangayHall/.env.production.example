# Production settings for the health-center server (see docs/deployment.md).
# Copy to .env, then run `php artisan key:generate` ONCE and keep a sealed copy
# of the finished .env in the Barangay Hall safe (needed to restore backups).

APP_NAME="Kalawag II Health Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The name (or LAN address) in the mkcert certificate. Must be https:// for GPS.
APP_URL=https://kalawag2-health.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

# A dedicated MySQL account with rights on this database only (not root).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barangay_health
DB_USERNAME=barangay_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# No mail server on the barangay LAN: password resets are done by the Admin.
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Barangay health system (see config/barangay.php)
BACKUP_MYSQLDUMP_PATH="C:/xampp/mysql/bin/mysqldump.exe"
BACKUP_TIME=23:00
RETENTION_YEARS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
